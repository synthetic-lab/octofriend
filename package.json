{
  "name": "octofriend-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "github:synthetic-lab/octofriend",
  "engines": {
    "bun": "1.4.3"
  },
  "workspaces": [
    "libocto",
    "octofriend"
  ],
  "scripts": {
    "dev": "bun --watch octofriend/source/cli/cli.tsx",
    "exec": "bun octofriend/source/cli/cli.tsx",
    "exec:prod": "NODE_ENV=production bun octofriend/source/cli/bin.ts",
    "test": "bun run --parallel --workspaces test",
    "test:run": "bun run --workspaces test:run",
    "preview": "bun run --cwd octofriend preview",
    "compile": "bun run --cwd octofriend compile",
    "compile:production": "bun run --cwd octofriend compile:production",
    "lint": "eslint . && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "bun-types": "^1.4.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "3.7.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.12",
    "esbuild": "0.28.1"
  }
}
