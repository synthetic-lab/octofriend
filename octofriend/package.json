{
  "name": "octofriend",
  "version": "0.0.60",
  "description": "An open-source coding helper. Very friendly!",
  "license": "MIT",
  "repository": "github:synthetic-lab/octofriend",
  "bin": {
    "octofriend": "bin/octo.sh",
    "octo": "bin/octo.sh"
  },
  "type": "module",
  "preferGlobal": true,
  "private": true,
  "scripts": {
    "dev": "bun --watch source/cli/cli.tsx",
    "exec": "bun source/cli/cli.tsx",
    "exec:prod": "NODE_ENV=production bun source/cli/bin.ts",
    "test": "bun test source --watch --preload ./source/test/setup.ts --timeout 30000",
    "preview": "bun demos/preview.ts",
    "test:run": "bun test source --preload ./source/test/setup.ts --timeout 30000",
    "compile": "bun build.ts",
    "compile:production": "NODE_ENV=production bun run compile"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@commander-js/extra-typings": "^13.1.0",
    "antipattern": "^0.0.7",
    "chalk": "^5.4.1",
    "cli-spinners": "^2.7.0",
    "clipboardy": "^5.0.0",
    "commander": "^13.1.0",
    "diff": "^8.0.3",
    "drizzle-orm": "^0.45.2",
    "figlet": "^1.8.0",
    "figures": "^6.1.0",
    "highlight.js": "^11.11.1",
    "ignore": "^7.0.5",
    "json-schema": "^0.4.0",
    "json5": "^2.2.3",
    "libocto": "0.0.0",
    "marked": "^16.2.0",
    "openai": "^5.9.0",
    "paintcannon": "0.0.50",
    "paintcannon-react": "0.0.50",
    "react": "^19.2.6",
    "shell-quote": "^1.12.0",
    "string-width": "^7.2.0",
    "structural": "^0.0.36",
    "to-rotated": "^1.0.0",
    "which": "^6.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/react": "^19.2.6",
    "@types/react-test-renderer": "^19.1.0",
    "@types/shell-quote": "^1.7.5",
    "@types/which": "^3.0.4",
    "bun-plugin-react-compiler": "^0.3.9",
    "drizzle-kit": "^0.31.4",
    "parse-git-diff": "^0.0.19",
    "react-test-renderer": "^19.2.6"
  }
}
